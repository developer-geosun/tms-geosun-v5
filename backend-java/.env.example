SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Публічний доступ (див. кореневий .env): ngrok | static-ip
# PUBLIC_ACCESS_MODE і COMPOSE_PROFILES задаються в кореневому .env для docker compose.
PUBLIC_ACCESS_MODE=static-ip
PUBLIC_API_URL=http://178.136.237.7:8080

MYSQL_DATABASE=tms_auth
MYSQL_USER=tms_user
MYSQL_PASSWORD=tms_password
MYSQL_ROOT_PASSWORD=root
# Порт MySQL на хості при docker compose v4 (3306 — локальний сервер, 3307 — база v1).
MYSQL_HOST_PORT=3308
SERVER_HOST_PORT=8090

DB_URL=jdbc:mysql://localhost:3306/tms_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=tms_user
DB_PASSWORD=tms_password

JWT_SECRET=replace-me-with-strong-secret-of-at-least-32-characters
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800

# Пароль суперадміна для чутливих admin-операцій (перевірка через POST /api/v1/admin/super-admin/verify-password).
SUPER_ADMIN_PASSWORD=change-me-super-admin-password

# Первинний ADMIN (bootstrap при старті, якщо в БД немає ADMIN): ADMIN_EMAIL, ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1

# Перше підприємство і оператор платформи. Порожні значення зупиняють робочий старт.
DEFAULT_ENTERPRISE_CODE=geosun
DEFAULT_ENTERPRISE_NAME=GeoSun
PLATFORM_OPERATOR_EMAIL=operator@example.com
PLATFORM_OPERATOR_PASSWORD=ChangeMe1

EMAIL_VERIFICATION_EXPIRES_SECONDS=86400
# Базові URL застосунків; шляхи /verify-email і /reset-password додає backend.
ANGULAR_APP_BASE_URL=http://localhost:4210
FLUTTER_APP_BASE_URL=http://localhost:4300
# CORS origin frontend (GitHub Pages тощо), через кому
CORS_ALLOWED_ORIGIN_PATTERNS=
# SMTP для листів верифікації та скидання пароля. У профілі dev health mail вимкнено.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SITE_URL=https://www.geosun.net.ua
MAIL_PHONE=+380(98)4894118
MAIL_TELEGRAM_URL=https://t.me/+380984894118
MAIL_WHATSAPP_URL=https://wa.me/380984894118
# https, не viber:// — Gmail/Outlook вилучають не-http схеми, іконка стає неклікабельною.
MAIL_VIBER_URL=https://viber.me/380984894118
MAIL_FACEBOOK_URL=https://www.facebook.com/profile.php?id=100063988064019

RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_RESEND_VERIFICATION_SECONDS=60
RATE_LIMIT_REFRESH_MAX_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_PER_WINDOW=30

TOKEN_CLEANUP_RETENTION_DAYS=30
TOKEN_CLEANUP_CRON=0 0 2 * * *
COUNTRY_BREAKDOWN_PROVIDER=here
# Обов'язковий при COUNTRY_BREAKDOWN_PROVIDER=here (розбивка пробігу по країнах).
HERE_API_KEY=

# Telegram chatbot (verify) — default off
CHATBOT_ENABLED=false
CHATBOT_TELEGRAM_ENABLED=false
CHATBOT_TELEGRAM_BOT_TOKEN=
CHATBOT_TELEGRAM_SECRET_TOKEN=
CHATBOT_TELEGRAM_BOT_USERNAME=
CHATBOT_PUBLIC_BASE_URL=
